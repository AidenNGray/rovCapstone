/*
  ROV-side proof of concept  (Arduino UNO R4 WiFi - the board with the 12x8 LED matrix)

  Wiring
    Fathom-S ROV board  ->  Arduino
      TX  -> pin 0 (RX)      <- Blue Robotics' Arduino guide wires these straight through
      RX  -> pin 1 (TX)         (RX to RX, TX to TX). If nothing arrives, swap the two.
      5V  -> 5V   (or the breadboard 5V rail)
      GND -> GND  (grounds MUST be common)
    HC-SR04 ultrasonic sensor
      VCC -> 5V    Trig -> pin 9    Echo -> pin 10    GND -> GND
    ESC (motor test)
      ESC signal wire -> pin 6      ESC ground wire -> GND (common ground)
      ESC red wire: leave it OFF the Arduino unless you know it is a 5 V BEC and the Arduino isn't powered another way.
      Power the ESC from its own battery/supply, never from the Arduino.

  Messages (text, one per line, 115200 baud, on the hardware UART "Serial1" = pins 0/1)
    from Pi:  CMD:U / CMD:D / CMD:L / CMD:R   -> show that letter on the LED matrix, reply ACK:<letter>
              PING                            -> reply PONG
              THR:<-100..100>                 -> motor throttle %: + forward, - reverse (sent ~20 times a second)
              MAX:<0..100>                    -> set the speed limit (%); applies in both directions
    to Pi:    SENSOR:1:<cm>   every 500 ms    (SENSOR:1:-- if the sensor sees nothing)
              MOTOR:<pct>     every 500 ms    (throttle actually applied, signed)
              LIMIT:<pct>     every 500 ms    (current speed limit)

  Safety
    The limit starts at DEFAULT_MAX_PERCENT every time the board powers up, and can never go above
    HARD_MAX_PERCENT. The motor stops if no THR line arrives for 500 ms.
    Reversing needs a reversible ESC (BIDIRECTIONAL = true). Let the motor slow down before flipping direction.

  Joystick display (LED matrix, no extra parts)
    Bar graph from the centre: forward grows to the right (6 columns = 100 %), reverse grows to the left.
    The two centre dots in row 6 are always on, so you can see where zero is.
    The bar shows the stick position the Pi SENT; the motor itself is held to the limit.
    Bottom row: one dot that creeps along as THR messages arrive. Moving = Arduino is receiving.
    Dot frozen and bar blank = nothing received for 0.5 s (failsafe has stopped the motor).
    The board's built-in LED (pin 13) also toggles on every 5th THR message.

  Libraries: ArduinoGraphics + Arduino_LED_Matrix (both ship with the UNO R4 board package;
  Tools > Manage Libraries > "ArduinoGraphics" if the compiler can't find it).

  If your board is NOT an R4 WiFi (no LED matrix), delete the matrix lines; everything else works.
*/
#include "ArduinoGraphics.h"
#include "Arduino_LED_Matrix.h"
#include <Servo.h>

ArduinoLEDMatrix matrix;

const int TRIG_PIN = 9;
const int ECHO_PIN = 10;
const int SENSOR_ID = 1;
const unsigned long REPORT_MS = 500;

// ---- ESC / motor test settings
const int  ESC_PIN        = 6;
const bool BIDIRECTIONAL  = true;    // true: 1500 us = stop, can reverse (e.g. Blue Robotics Basic ESC)
                                     // false: 1000 us = stop, forward only (reverse requests become 0)
const int  DEFAULT_MAX_PERCENT = 25; // speed limit after every power-up
const int  HARD_MAX_PERCENT    = 100;// the limit can never be set above this, whatever the Pi sends
int maxPercent = DEFAULT_MAX_PERCENT;
const unsigned long FAILSAFE_MS = 500;   // no THR line for this long -> stop
const unsigned long ARM_MS      = 3000;  // hold the stop signal at power-up so the ESC arms
Servo esc;
unsigned long lastThr = 0;
int appliedPct = 0;
int shownReq = -999;      // what is currently drawn on the matrix
int shownBeat = -1;
int beat = 0;             // counts THR messages
bool stale = false;

String line = "";
unsigned long lastReport = 0;

void showChar(char c) {
  matrix.beginDraw();
  matrix.clear();
  matrix.stroke(0xFFFFFFFF);
  matrix.textFont(Font_5x7);
  matrix.beginText(3, 0, 0xFFFFFFFF);   // 5x7 glyph, roughly centered on 12x8
  matrix.print(c);
  matrix.endText();
  matrix.endDraw();
}

// returns distance in cm, or -1 if no echo
float readDistanceCm() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(2);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(10);
  digitalWrite(TRIG_PIN, LOW);
  unsigned long us = pulseIn(ECHO_PIN, HIGH, 30000UL);  // 30 ms timeout (~5 m)
  if (us == 0) return -1;
  return us * 0.0343 / 2.0;
}

// Bar graph from the centre: forward grows right, reverse grows left (6 columns each side).
// `req` is the requested throttle (-100..100). Row 6 has the two centre dots, row 7 the heartbeat dot.
void showBar(int req, int beatCol) {
  if (req == shownReq && beatCol == shownBeat) return;     // nothing changed, skip the redraw
  shownReq = req;
  shownBeat = beatCol;
  int n = (abs(req) * 6 + 50) / 100;                       // 0..6 columns
  matrix.beginDraw();
  matrix.clear();
  matrix.stroke(0xFFFFFFFF);
  matrix.point(5, 6);                                      // centre markers
  matrix.point(6, 6);
  for (int i = 0; i < n; i++) {
    int c = (req >= 0) ? 6 + i : 5 - i;
    matrix.line(c, 0, c, 5);
  }
  if (beatCol >= 0) matrix.point(beatCol, 7);
  matrix.endDraw();
}

int stopMicros() { return BIDIRECTIONAL ? 1500 : 1000; }

void applyThrottle(int pct) {
  int requested = constrain(pct, -100, 100);               // stick position as received, for the display
  int applied = constrain(requested, -maxPercent, maxPercent);
  if (!BIDIRECTIONAL && applied < 0) applied = 0;
  appliedPct = applied;
  esc.writeMicroseconds(BIDIRECTIONAL ? 1500 + applied * 4 : 1000 + applied * 10);   // 1100..1900 or 1000..2000 us

  // show what we just received
  beat++;
  stale = false;
  digitalWrite(LED_BUILTIN, (beat / 5) % 2);              // built-in LED blinks while messages arrive
  showBar(requested, (beat / 5) % 12);                    // dot creeps along the bottom row
}

void handleLine(const String &msg) {
  if (msg.startsWith("CMD:") && msg.length() >= 5) {
    char c = msg.charAt(4);
    showChar(c);                       // proof the command made it down the tether
    Serial1.print("ACK:");
    Serial1.println(c);                // proof the reply can come back up it
  } else if (msg == "PING") {
    Serial1.println("PONG");
  } else if (msg.startsWith("MAX:")) {
    maxPercent = constrain(msg.substring(4).toInt(), 0, HARD_MAX_PERCENT);
  } else if (msg.startsWith("THR:")) {
    applyThrottle(msg.substring(4).toInt());
    lastThr = millis();
  }
}

void setup() {
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(LED_BUILTIN, OUTPUT);
  Serial1.begin(115200);               // to the Fathom-S ROV board
  matrix.begin();
  showChar('*');                       // boot indicator
  esc.attach(ESC_PIN);
  esc.writeMicroseconds(stopMicros()); // arming: hold stop while the ESC starts up
  delay(ARM_MS);
  while (Serial1.available()) Serial1.read();   // drop anything that piled up while arming
  lastThr = millis();
}

void loop() {
  while (Serial1.available()) {
    char ch = Serial1.read();
    if (ch == '\n') {
      line.trim();
      if (line.length()) handleLine(line);
      line = "";
    } else if (line.length() < 40) {
      line += ch;
    }
  }

  // failsafe: lost the Pi, tether or controller -> stop the motor
  if (millis() - lastThr > FAILSAFE_MS) {
    esc.writeMicroseconds(stopMicros());
    appliedPct = 0;
    if (!stale) {                      // blank the display once: bar gone, no dot
      stale = true;
      shownReq = -998;
      matrix.beginDraw();
      matrix.clear();
      matrix.endDraw();
    }
  }

  if (millis() - lastReport >= REPORT_MS) {
    lastReport = millis();
    float cm = readDistanceCm();
    Serial1.print("SENSOR:");
    Serial1.print(SENSOR_ID);
    Serial1.print(":");
    if (cm < 0) Serial1.println("--");
    else Serial1.println(cm, 1);
    Serial1.print("MOTOR:");
    Serial1.println(appliedPct);
    Serial1.print("LIMIT:");
    Serial1.println(maxPercent);
  }
}
